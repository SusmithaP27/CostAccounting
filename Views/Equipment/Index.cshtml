@model CostAccounting.Models.EquipmentIndexVM
@{
    ViewData["Title"] = "Equipments";
    string sortCol = (ViewBag.SortColumn as string) ?? "Code";
    string sortDir = (ViewBag.SortDir as string) ?? "asc";
}

@Html.AntiForgeryToken()

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 class="mb-0 fw-semibold">Equipments</h4>
        <p class="text-muted small mb-0">
            @Model.TotalCount record@(Model.TotalCount != 1 ? "s" : "")
        </p>
    </div>
    <button class="btn btn-primary btn-sm" id="btnOpenAdd">
        <i class="bi bi-plus-lg me-1"></i>Add Equipment
    </button>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 px-3">
        <form id="filterForm" class="row g-2 align-items-center">
            <div class="col">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input id="searchTerm" name="searchTerm" type="text"
                           class="form-control border-start-0 ps-0 bg-white"
                           placeholder="Search code, category, make, model, department…"
                           value="@Model.SearchTerm" />
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearSearch">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
            </div>

            <div class="col-auto">
                <select id="filterActive" name="filterActive" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    @if (Model.FilterActive == true)
                    {
                        <option value="true" selected>Active</option>
                    }
                    else
                    {
                        <option value="true">Active</option>
                    }
                    @if (Model.FilterActive == false)
                    {
                        <option value="false" selected>Inactive</option>
                    }
                    else
                    {
                        <option value="false">Inactive</option>
                    }
                </select>
            </div>

            <div class="col-auto d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-link text-muted text-decoration-none">
                    Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div id="tableSection">
    @await Html.PartialAsync("_EquipmentsTable", Model)
</div>


@* ── ADD MODAL ── *@
<div class="modal fade" id="modalAdd" tabindex="-1" aria-labelledby="modalAddLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0" id="modalAddLabel">
                    <i class="bi bi-plus-circle me-2"></i>Add New Equipment
                </h6>
                <button type="button" class="btn-close btn-close-white btn-sm"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pb-2">
                <div id="addAlertArea"></div>
                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label form-label-sm fw-semibold">
                            Code <span class="text-danger">*</span>
                        </label>
                        <input id="add_Code" type="text"
                               class="form-control form-control-sm"
                               placeholder="e.g. EQ-001" />
                        <div class="invalid-feedback">Code is required.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label form-label-sm fw-semibold">Category</label>
                        <input id="add_Category" type="text"
                               class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label form-label-sm fw-semibold">Mfg Year</label>
                        <input id="add_MfgYear" type="text"
                               class="form-control form-control-sm"
                               placeholder="e.g. 2020" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label form-label-sm fw-semibold">Date In Service</label>
                        <input id="add_DateInService" type="date"
                               class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label form-label-sm fw-semibold">Make</label>
                        <input id="add_Make" type="text"
                               class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label form-label-sm fw-semibold">Model</label>
                        <input id="add_Model" type="text"
                               class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label form-label-sm fw-semibold">Department</label>
                        <input id="add_Department" type="text"
                               class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-4 d-flex align-items-end pb-1">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox"
                                   id="add_Active" checked />
                            <label class="form-check-label form-label-sm fw-semibold"
                                   for="add_Active">Active</label>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-sm btn-primary" id="btnSaveAdd">
                    <span id="btnSaveAddSpinner"
                          class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                    <i class="bi bi-floppy me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>


@* ── DELETE MODAL ── *@
<div class="modal fade" id="modalDelete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content shadow">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete
                </h6>
                <button type="button" class="btn-close btn-close-white btn-sm"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-3">
                <p class="mb-1">Delete equipment</p>
                <p class="fw-bold mb-0" id="deleteCodeLabel"></p>
                <small class="text-muted">This action cannot be undone.</small>
            </div>
            <div class="modal-footer py-2 justify-content-center">
                <button type="button" class="btn btn-sm btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-sm btn-danger" id="btnConfirmDelete">
                    <span id="btnDeleteSpinner"
                          class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>


@* ── TOAST ── *@
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="appToast" class="toast align-items-center border-0" role="alert" aria-live="assertive">
        <div class="d-flex">
            <div class="toast-body" id="toastMsg"></div>
            <button type="button" class="btn-close me-2 m-auto"
                    data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        (function () {
            'use strict';

            // ── State ────────────────────────────────────────────────────────────
            let sortCol = '@sortCol';
            let sortDir = '@sortDir';
            let curPage = @Model.CurrentPage;

            // ── Helpers ──────────────────────────────────────────────────────────
            const $ = id => document.getElementById(id);

            function toFormData(data) {
                const fd = new FormData();
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) fd.append('__RequestVerificationToken', token.value);
                for (const [key, val] of Object.entries(data)) {
                    if (val !== null && val !== undefined) fd.append(key, val);
                }
                return fd;
            }

            async function apiPost(url, data) {
                const res = await fetch(url, {
                    method: 'POST',
                    body:   toFormData(data)
                });
                if (!res.ok) {
                    const txt = await res.text();
                    throw new Error(txt || res.statusText);
                }
                const json = await res.json();
                if (!json.success) throw new Error(json.message ?? 'Request failed.');
                return json;
            }

            function showToast(msg, type = 'success') {
                const toast = $('appToast');
                $('toastMsg').textContent = msg;
                toast.className = `toast align-items-center border-0 text-bg-${type}`;
                bootstrap.Toast.getOrCreateInstance(toast, { delay: 3000 }).show();
            }

            function buildQS(page) {
                const p = new URLSearchParams();
                const search = $('searchTerm')?.value;
                const active = $('filterActive')?.value;
                if (search) p.set('searchTerm',   search);
                if (active) p.set('filterActive', active);
                p.set('sortColumn', sortCol);
                p.set('sortDir',    sortDir);
                p.set('page',       page);
                p.set('pageSize',   15);
                return p.toString();
            }

            async function reloadTable(page) {
                curPage = page;
                try {
                    const res = await fetch(`@Url.Action("Index")?${buildQS(page)}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    $('tableSection').innerHTML = await res.text();
                    bindTableEvents();
                } catch (e) {
                    showToast('Failed to load table.', 'danger');
                }
            }

            $('filterForm').addEventListener('submit', e => {
                e.preventDefault();
                reloadTable(1);
            });

            $('searchTerm')?.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); reloadTable(1); }
            });

            $('btnClearSearch')?.addEventListener('click', () => {
                $('searchTerm').value = '';
                reloadTable(1);
            });

            function bindTableEvents() {
                document.querySelectorAll('.sortable[data-sort]').forEach(th => {
                    th.style.cursor = 'pointer';
                    th.style.userSelect = 'none';
                    th.addEventListener('click', () => {
                        const col = th.dataset.sort;
                        if (sortCol.toLowerCase() === col.toLowerCase()) {
                            sortDir = sortDir === 'asc' ? 'desc' : 'asc';
                        } else {
                            sortCol = col;
                            sortDir = 'asc';
                        }
                        reloadTable(1);
                    });
                });

                document.querySelectorAll('[data-page]').forEach(btn => {
                    btn.addEventListener('click', () => reloadTable(+btn.dataset.page));
                });

                document.querySelectorAll('.btn-edit').forEach(btn => {
                    btn.addEventListener('click', () => enterEdit(btn.dataset.id));
                });

                document.querySelectorAll('.btn-save').forEach(btn => {
                    btn.addEventListener('click', () => saveInline(btn.dataset.id));
                });

                document.querySelectorAll('.btn-cancel').forEach(btn => {
                    btn.addEventListener('click', () => reloadTable(curPage));
                });

                document.querySelectorAll('.btn-delete').forEach(btn => {
                    btn.addEventListener('click', () => openDeleteModal(btn.dataset.id, btn.dataset.code));
                });
            }

            function enterEdit(id) {
                const row = document.getElementById('row-' + id);
                row.querySelectorAll('.cell-view') .forEach(el => el.classList.add('d-none'));
                row.querySelectorAll('.cell-input').forEach(el => el.classList.remove('d-none'));
                row.querySelector('.btn-edit')  .classList.add('d-none');
                row.querySelector('.btn-delete').classList.add('d-none');
                row.querySelector('.btn-save')  .classList.remove('d-none');
                row.querySelector('.btn-cancel').classList.remove('d-none');
                row.querySelector('.cell-input:not(select)')?.focus();
            }

            async function saveInline(id) {
                const row = document.getElementById('row-' + id);
                const get = field => {
                    const el = row.querySelector(`[data-field="${field}"]`);
                    if (!el) return null;
                    if (el.type === 'checkbox') return el.checked;
                    return el.value || null;
                };

                const payload = {
                    objectID:      +id,
                    category:      get('category'),
                    mfgYear:       get('mfgYear'),
                    dateInService: get('dateInService'),
                    make:          get('make'),
                    equipmentModel:get('equipmentModel'),
                    department:    get('department'),
                    active:        get('active')
                };

                const saveBtn = row.querySelector('.btn-save');
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                try {
                    await apiPost('@Url.Action("Update", "Equipment")', payload);
                    showToast('Saved successfully.');
                    reloadTable(curPage);
                } catch (err) {
                    showToast('Save failed: ' + err.message, 'danger');
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = '<i class="bi bi-check-lg"></i>';
                }
            }

            let pendingDeleteId = null;

            function openDeleteModal(id, code) {
                pendingDeleteId = id;
                $('deleteCodeLabel').textContent = code ?? ('ID ' + id);
                bootstrap.Modal.getOrCreateInstance($('modalDelete')).show();
            }

            $('btnConfirmDelete').addEventListener('click', async () => {
                if (!pendingDeleteId) return;
                const spinner = $('btnDeleteSpinner');
                spinner.classList.remove('d-none');
                $('btnConfirmDelete').disabled = true;

                try {
                    await apiPost('@Url.Action("Delete", "Equipment")', +pendingDeleteId);
                    bootstrap.Modal.getInstance($('modalDelete')).hide();
                    showToast('Equipment deleted.');
                    reloadTable(1);
                } catch (err) {
                    showToast('Delete failed: ' + err.message, 'danger');
                } finally {
                    spinner.classList.add('d-none');
                    $('btnConfirmDelete').disabled = false;
                    pendingDeleteId = null;
                }
            });

            $('btnOpenAdd').addEventListener('click', () => {
                ['add_Code','add_Category','add_Make','add_Model','add_Department'].forEach(id => {
                    $(id).value = '';
                    $(id).classList.remove('is-invalid');
                });
                $('add_MfgYear').value = '';
                $('add_DateInService').value = '';
                $('add_Active').checked = true;
                $('addAlertArea').innerHTML = '';
                bootstrap.Modal.getOrCreateInstance($('modalAdd')).show();
            });

            $('btnSaveAdd').addEventListener('click', async () => {
                const codeEl = $('add_Code');
                if (!codeEl.value.trim()) {
                    codeEl.classList.add('is-invalid');
                    codeEl.focus();
                    return;
                }
                codeEl.classList.remove('is-invalid');

                const payload = {
                    code:          codeEl.value.trim(),
                    category:      $('add_Category').value      || null,
                    mfgYear:       $('add_MfgYear').value       || null,
                    dateInService: $('add_DateInService').value  || null,
                    make:          $('add_Make').value          || null,
                    equipmentModel:$('add_Model').value         || null,
                    department:    $('add_Department').value    || null,
                    active:        $('add_Active').checked
                };

                const spinner = $('btnSaveAddSpinner');
                spinner.classList.remove('d-none');
                $('btnSaveAdd').disabled = true;

                try {
                    await apiPost('@Url.Action("Create", "Equipment")', payload);
                    bootstrap.Modal.getInstance($('modalAdd')).hide();
                    showToast('Equipment added successfully.');
                    reloadTable(1);
                } catch (err) {
                    $('addAlertArea').innerHTML =
                        `<div class="alert alert-danger alert-sm py-1 px-2 small mb-2">
                            <i class="bi bi-exclamation-circle me-1"></i>${err.message}
                        </div>`;
                } finally {
                    spinner.classList.add('d-none');
                    $('btnSaveAdd').disabled = false;
                }
            });

            $('modalAdd').addEventListener('keydown', e => {
                if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
                    e.preventDefault();
                    $('btnSaveAdd').click();
                }
            });

            bindTableEvents();

        })();
    </script>
}