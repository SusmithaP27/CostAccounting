@model CostAccounting.Models.ChangePasswordVM
@{
    ViewData["Title"] = "Change Password";
    bool isFirstSignIn = ViewBag.IsFirstSignIn ?? false;
}

@* ── PAGE HEADER ─────────────────────────────────────────────────────── *@
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 class="mb-0 fw-semibold">@(isFirstSignIn ? "Set Your Password" : "Change Password")</h4>
        <p class="text-muted small mb-0">
            @(isFirstSignIn ? "Choose a new password to continue" : "Update the password you use to sign in")
        </p>
    </div>
    @if (!isFirstSignIn)
    {
        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Profile
        </a>
    }
</div>

<div class="row">
    <div class="col-lg-6 col-xl-5">
        <div class="card border-0 shadow-sm">

            <div class="card-header bg-primary text-white py-2 px-3">
                <h6 class="mb-0">
                    <i class="bi bi-key me-2"></i>@(isFirstSignIn ? "Set Password" : "Change Password")
                </h6>
            </div>

            <div class="card-body p-3">

                @if (isFirstSignIn)
                {
                    <div class="alert alert-warning py-2 small d-flex align-items-start">
                        <i class="bi bi-exclamation-triangle me-2 mt-1"></i>
                        <div>
                            This is your first sign-in (or an admin just reset your password).
                            Enter the temporary password you were given, then choose a new one.
                        </div>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <form asp-action="ChangePassword" asp-controller="Profile" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label form-label-sm fw-semibold">
                            @(isFirstSignIn ? "Temporary Password" : "Current Password")
                        </label>
                        <div class="input-group input-group-sm">
                            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" autofocus />
                            <button type="button" class="btn btn-outline-secondary toggle-pw" tabindex="-1" title="Show / hide">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <hr class="my-3" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label form-label-sm fw-semibold"></label>
                        <div class="input-group input-group-sm">
                            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary toggle-pw" tabindex="-1" title="Show / hide">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="progress mt-2" style="height:4px">
                            <div id="pwStrengthBar" class="progress-bar" style="width:0%"></div>
                        </div>
                        <div id="pwStrengthText" class="form-text small"></div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmNewPassword" class="form-label form-label-sm fw-semibold"></label>
                        <div class="input-group input-group-sm">
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary toggle-pw" tabindex="-1" title="Show / hide">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        <div id="pwMatchText" class="form-text small"></div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        @if (!isFirstSignIn)
                        {
                            <a asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-secondary">Cancel</a>
                        }
                        <button type="submit" class="btn btn-sm btn-primary px-4">
                            <i class="bi bi-floppy me-1"></i>@(isFirstSignIn ? "Set Password & Continue" : "Change Password")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        'use strict';

        // Show / hide password
        document.querySelectorAll('.toggle-pw').forEach(btn => {
            btn.addEventListener('click', () => {
                const input = btn.parentElement.querySelector('input');
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        });

        const np   = document.getElementById('NewPassword');
        const cp   = document.getElementById('ConfirmNewPassword');
        const bar  = document.getElementById('pwStrengthBar');
        const txt  = document.getElementById('pwStrengthText');
        const mtxt = document.getElementById('pwMatchText');

        // Simple strength hint (guidance only; the server enforces the real rules)
        function strength(p) {
            let s = 0;
            if (p.length >= 8)  s++;
            if (p.length >= 12) s++;
            if (/[a-z]/.test(p) && /[A-Z]/.test(p)) s++;
            if (/\d/.test(p)) s++;
            if (/[^A-Za-z0-9]/.test(p)) s++;
            return s; // 0..5
        }

        function updateStrength() {
            const p = np.value;
            if (!p) { bar.style.width = '0%'; txt.textContent = ''; return; }
            const s = strength(p);
            const levels = [
                ['Very weak', 'bg-danger',  20],
                ['Weak',      'bg-danger',  40],
                ['Fair',      'bg-warning', 60],
                ['Good',      'bg-info',    80],
                ['Strong',    'bg-success', 100],
                ['Strong',    'bg-success', 100]
            ];
            const [label, cls, w] = levels[s];
            bar.className = 'progress-bar ' + cls;
            bar.style.width = w + '%';
            txt.textContent = 'Strength: ' + label;
        }

        function updateMatch() {
            if (!cp.value) { mtxt.textContent = ''; return; }
            const ok = np.value === cp.value;
            mtxt.className = 'form-text small ' + (ok ? 'text-success' : 'text-danger');
            mtxt.innerHTML = ok
                ? '<i class="bi bi-check-circle me-1"></i>Passwords match'
                : '<i class="bi bi-x-circle me-1"></i>Passwords do not match';
        }

        np.addEventListener('input', () => { updateStrength(); updateMatch(); });
        cp.addEventListener('input', updateMatch);
    })();
    </script>
}
