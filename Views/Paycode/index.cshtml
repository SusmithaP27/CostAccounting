@model CostAccounting.Models.PaycodeIndexVM
@{
    ViewData["Title"] = "Paycodes";

    string SortIcon(string column) =>
        Model.SortColumn?.Equals(column, StringComparison.OrdinalIgnoreCase) == true
            ? (Model.SortDirection == "asc" ? "bi-sort-alpha-down" : "bi-sort-alpha-up")
            : "bi-arrow-down-up text-muted";

    string NextDirection(string column) =>
        Model.SortColumn?.Equals(column, StringComparison.OrdinalIgnoreCase) == true
            && Model.SortDirection == "asc" ? "desc" : "asc";

    // Pager links carry the current filters, sort AND the chosen page size
    string PageUrl(int pg) => Url.Action("Index", new
    {
        searchTerm = Model.SearchTerm,
        filterActive = Model.FilterActive,
        currentPage = pg,
        pageSize = Model.PageSize,
        sortColumn = Model.SortColumn,
        sortDirection = Model.SortDirection
    })!;

    string YesNo(bool v) => v
        ? "<span class=\"badge bg-success-subtle text-success border border-success-subtle\"><i class=\"bi bi-check-circle-fill me-1\"></i>Yes</span>"
        : "<span class=\"badge bg-secondary-subtle text-secondary border\">No</span>";

    // Clear is shown only when something differs from the default (Active = Yes)
    bool hasActiveFilters = !string.IsNullOrEmpty(Model.SearchTerm) || Model.FilterActive != true;
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 fw-bold">
            <i class="bi bi-cash-coin text-primary me-2"></i>Paycodes
        </h4>
        <div class="d-flex gap-2">
            <button type="button" id="exportPaycodesPdf" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-file-earmark-pdf me-1"></i> Export to PDF
            </button>
            <button class="btn btn-primary btn-sm" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> Add New Paycode
            </button>
        </div>
    </div>

    <!-- Search & Filter Toolbar -->
    <form method="get" id="filterForm">
        <input type="hidden" name="sortColumn" value="@Model.SortColumn" />
        <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
        <input type="hidden" name="pageSize" id="pageSizeInput" value="@Model.PageSize" />
        <div class="card shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="row g-2 align-items-center">

                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="searchTerm" id="searchInput" value="@Model.SearchTerm"
                                   class="form-control form-control-sm"
                                   placeholder="Search code, description, abbrev…" />
                        </div>
                    </div>

                    <div class="col-auto">
                        <div class="input-group input-group-sm">
                            <label class="input-group-text bg-white">Active</label>
                            <select name="filterActive" class="form-select form-select-sm"
                                    onchange="document.getElementById('filterForm').submit()">
                                <option value="" selected="@(Model.FilterActive == null ? "selected" : null)">All</option>
                                <option value="true" selected="@(Model.FilterActive == true ? "selected" : null)">Yes</option>
                                <option value="false" selected="@(Model.FilterActive == false ? "selected" : null)">No</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-search me-1"></i>Search
                        </button>
                    </div>

                    @if (hasActiveFilters)
                    {
                        <div class="col-auto">
                            <a href="@Url.Action("Index", new { pageSize = Model.PageSize })" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-x-circle me-1"></i>Clear
                            </a>
                        </div>
                    }

                    <div class="col-auto ms-auto">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                            @Model.TotalCount record(s)
                        </span>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Table Card -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            @{
                                (string Col, string Label, string Width, string Extra)[] cols = new[]
                                {
                                    ("Code", "Code", "100px", ""),
                                    ("Description", "Description", "", ""),
                                    ("Abbrev", "Abbrev", "120px", ""),
                                    ("Calculation", "Calculation", "130px", "text-end"),
                                    ("OutOfClass", "Out of Class", "110px", "text-center"),
                                    ("ShiftDiff", "Shift Diff", "100px", "text-center"),
                                    ("OPP", "OPP", "90px", "text-center"),
                                    ("Active", "Active", "90px", "text-center")
                                };
                            }
                            @foreach (var c in cols)
                            {
                                <th style="@(string.IsNullOrEmpty(c.Width) ? "" : $"width:{c.Width}")" class="@c.Extra">
                                    <a class="text-decoration-none text-dark d-flex align-items-center gap-1 @(c.Extra == "text-center" ? "justify-content-center" : c.Extra == "text-end" ? "justify-content-end" : "")"
                                       href="@Url.Action("Index", new {
                                            searchTerm = Model.SearchTerm,
                                            filterActive = Model.FilterActive,
                                            currentPage = 1,
                                            pageSize = Model.PageSize,
                                            sortColumn = c.Col,
                                            sortDirection = NextDirection(c.Col)
                                       })">
                                        @c.Label <i class="bi @SortIcon(c.Col)"></i>
                                    </a>
                                </th>
                            }
                            <th class="text-center" style="width:120px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Paycodes.Any())
                        {
                            @foreach (var p in Model.Paycodes)
                            {
                                <tr id="row-@p.Code"
                                    data-active="@(p.Active ? "true" : "false")"
                                    data-ooc="@(p.OutOfClass ? "true" : "false")"
                                    data-sd="@(p.ShiftDiff ? "true" : "false")"
                                    data-opp="@(p.OPP ? "true" : "false")">

                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold">@p.Code</span>
                                    </td>

                                    <td>
                                        <span id="desc-display-@p.Code">@p.Description</span>
                                        <input id="desc-input-@p.Code" class="form-control form-control-sm d-none"
                                               value="@p.Description" maxlength="150" />
                                    </td>

                                    <td>
                                        <span id="abbrev-display-@p.Code">@p.Abbrev</span>
                                        <input id="abbrev-input-@p.Code" class="form-control form-control-sm d-none"
                                               value="@p.Abbrev" maxlength="20" />
                                    </td>

                                    <td class="text-end">
                                        <span id="calc-display-@p.Code">@p.Calculation.ToString("0.00##")</span>
                                        <input id="calc-input-@p.Code" type="number" step="0.0001" min="0" max="9999.9999"
                                               class="form-control form-control-sm text-end d-none" value="@p.Calculation" />
                                    </td>

                                    <td class="text-center" id="ooc-cell-@p.Code">@Html.Raw(YesNo(p.OutOfClass))</td>
                                    <td class="text-center" id="sd-cell-@p.Code">@Html.Raw(YesNo(p.ShiftDiff))</td>
                                    <td class="text-center" id="opp-cell-@p.Code">@Html.Raw(YesNo(p.OPP))</td>
                                    <td class="text-center" id="active-cell-@p.Code">@Html.Raw(YesNo(p.Active))</td>

                                    <td class="text-center">
                                        <div id="actions-view-@p.Code">
                                            <button class="btn btn-outline-secondary btn-sm py-0 px-2"
                                                    onclick="startEdit(@p.Code)" title="Inline Edit">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        </div>
                                        <div id="actions-edit-@p.Code" style="display:none">
                                            <button class="btn btn-success btn-sm py-0 px-2" id="save-btn-@p.Code"
                                                    onclick="saveRow(@p.Code)" title="Save">
                                                <i class="bi bi-check-lg"></i> Save
                                            </button>
                                            <button class="btn btn-secondary btn-sm py-0 px-2 ms-1"
                                                    onclick="cancelEdit(@p.Code)" title="Cancel">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    No paycodes found. Try adjusting your search or filters.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        @if (Model.TotalCount > 0)
        {
            <div class="card-footer d-flex justify-content-between align-items-center py-2">
                <small class="text-muted">
                    Showing
                    <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)–@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong>
                    of <strong>@Model.TotalCount</strong> records
                </small>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Paycode pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@PageUrl(1)">«</a>
                            </li>
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@PageUrl(Model.CurrentPage - 1)">‹</a>
                            </li>

                            @{
                                int startPage = Math.Max(1, Model.CurrentPage - 2);
                                int endPage   = Math.Min(Model.TotalPages, startPage + 4);
                                startPage     = Math.Max(1, endPage - 4);
                            }
                            @for (int pg = startPage; pg <= endPage; pg++)
                            {
                                <li class="page-item @(pg == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@PageUrl(pg)">@pg</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@PageUrl(Model.CurrentPage + 1)">›</a>
                            </li>
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@PageUrl(Model.TotalPages)">»</a>
                            </li>
                        </ul>
                    </nav>
                }

                <partial name="_PageSizeSelect" model="Model.PageSize" />
            </div>
        }
    </div>
</div>

<!-- ===================== ADD NEW MODAL ===================== -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="addModalLabel">
                    <i class="bi bi-plus-circle me-2 text-primary"></i>Add New Paycode
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Code <span class="text-danger">*</span></label>
                    <input type="number" id="newCode" class="form-control form-control-sm" min="1" max="32767" placeholder="e.g. 101" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Description</label>
                    <input type="text" id="newDescription" class="form-control form-control-sm" maxlength="150" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Abbrev</label>
                        <input type="text" id="newAbbrev" class="form-control form-control-sm" maxlength="20" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Calculation</label>
                        <input type="number" id="newCalculation" class="form-control form-control-sm"
                               step="0.0001" min="0" max="9999.9999" value="0" />
                    </div>
                </div>

                <div class="row g-3 mb-2">
                    <div class="col-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="newActive" checked />
                            <label class="form-check-label small" for="newActive">Active</label>
                        </div>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="newOutOfClass" />
                            <label class="form-check-label small" for="newOutOfClass">Out of Class</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="newShiftDiff" />
                            <label class="form-check-label small" for="newShiftDiff">Shift Diff</label>
                        </div>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="newOPP" />
                            <label class="form-check-label small" for="newOPP">OPP</label>
                        </div>
                    </div>
                </div>

                <div id="modalError" class="alert alert-danger py-2 small d-none mt-2" role="alert"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary btn-sm" id="saveNewBtn" onclick="saveNew()">
                    <i class="bi bi-save me-1"></i>Save Paycode
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===================== TOAST ===================== -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
    <div id="liveToast" class="toast align-items-center border-0 shadow" role="alert" aria-live="assertive">
        <div class="d-flex">
            <div class="toast-body fw-semibold small" id="toastMessage">Saved.</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    const token   = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const bsModal = new bootstrap.Modal(document.getElementById('addModal'));
    const toastEl = document.getElementById('liveToast');
    const $ = id => document.getElementById(id);

    // ── Toast ─────────────────────────────────────────────────────
    function showToast(message, type = 'success') {
        toastEl.className = `toast align-items-center border-0 shadow text-bg-${type}`;
        $('toastMessage').textContent = message;
        bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3000 }).show();
    }

    function yesNoBadge(val) {
        return val
            ? `<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i>Yes</span>`
            : `<span class="badge bg-secondary-subtle text-secondary border">No</span>`;
    }

    function switchHtml(inputId, checked) {
        return `<div class="form-check form-switch d-flex justify-content-center mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="${inputId}" ${checked ? 'checked' : ''}>
                </div>`;
    }

    // ── Add modal ─────────────────────────────────────────────────
    function openAddModal() {
        $('newCode').value = '';
        $('newDescription').value = '';
        $('newAbbrev').value = '';
        $('newCalculation').value = 0;
        $('newActive').checked = true;
        $('newOutOfClass').checked = false;
        $('newShiftDiff').checked = false;
        $('newOPP').checked = false;
        $('modalError').classList.add('d-none');
        bsModal.show();
        setTimeout(() => $('newCode').focus(), 300);
    }

    async function saveNew() {
        const errEl = $('modalError');
        const code  = $('newCode').value.trim();
        const calc  = $('newCalculation').value.trim() || '0';

        if (!code || Number(code) <= 0) {
            errEl.textContent = 'Code is required and must be a positive number.';
            errEl.classList.remove('d-none');
            $('newCode').focus();
            return;
        }
        if (Number(calc) < 0 || Number(calc) >= 10000) {
            errEl.textContent = 'Calculation must be between 0 and 9999.9999.';
            errEl.classList.remove('d-none');
            return;
        }

        const btn = $('saveNewBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
        errEl.classList.add('d-none');

        try {
            const res = await fetch('@Url.Action("Create", "Paycode")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    Code: code,
                    Description: $('newDescription').value.trim(),
                    Abbrev: $('newAbbrev').value.trim(),
                    Calculation: calc,
                    Active: $('newActive').checked,
                    OutOfClass: $('newOutOfClass').checked,
                    ShiftDiff: $('newShiftDiff').checked,
                    OPP: $('newOPP').checked,
                    __RequestVerificationToken: token
                })
            });

            const ct = res.headers.get('content-type') || '';
            if (!ct.includes('application/json'))
                throw new Error('Unexpected server response. Please refresh and try again.');

            const data = await res.json();
            if (data.success) {
                bsModal.hide();
                showToast('Paycode added successfully!', 'success');
                setTimeout(() => location.reload(), 900);
            } else {
                errEl.textContent = data.message || 'Failed to save.';
                errEl.classList.remove('d-none');
            }
        } catch (err) {
            errEl.textContent = err.message || 'Network error. Please try again.';
            errEl.classList.remove('d-none');
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-save me-1"></i>Save Paycode';
    }

    document.querySelectorAll('#addModal input[type="text"], #addModal input[type="number"]').forEach(el => {
        el.addEventListener('keydown', e => { if (e.key === 'Enter') saveNew(); });
    });

    // ── Inline edit — start ───────────────────────────────────────
    function startEdit(id) {
        const row = $('row-' + id);
        row.classList.add('table-warning');

        ['desc', 'abbrev', 'calc'].forEach(k => {
            $(`${k}-display-${id}`).classList.add('d-none');
            $(`${k}-input-${id}`).classList.remove('d-none');
        });

        $('ooc-cell-' + id).innerHTML    = switchHtml('edit-ooc-' + id,    row.dataset.ooc === 'true');
        $('sd-cell-' + id).innerHTML     = switchHtml('edit-sd-' + id,     row.dataset.sd === 'true');
        $('opp-cell-' + id).innerHTML    = switchHtml('edit-opp-' + id,    row.dataset.opp === 'true');
        $('active-cell-' + id).innerHTML = switchHtml('edit-active-' + id, row.dataset.active === 'true');

        $('actions-view-' + id).style.display = 'none';
        $('actions-edit-' + id).style.display = 'block';
        $('desc-input-' + id).focus();
    }

    // ── Inline edit — cancel (no reload) ──────────────────────────
    function cancelEdit(id) {
        const row = $('row-' + id);
        row.classList.remove('table-warning');

        ['desc', 'abbrev', 'calc'].forEach(k => {
            $(`${k}-display-${id}`).classList.remove('d-none');
            $(`${k}-input-${id}`).classList.add('d-none');
        });

        $('ooc-cell-' + id).innerHTML    = yesNoBadge(row.dataset.ooc === 'true');
        $('sd-cell-' + id).innerHTML     = yesNoBadge(row.dataset.sd === 'true');
        $('opp-cell-' + id).innerHTML    = yesNoBadge(row.dataset.opp === 'true');
        $('active-cell-' + id).innerHTML = yesNoBadge(row.dataset.active === 'true');

        $('actions-view-' + id).style.display = 'block';
        $('actions-edit-' + id).style.display = 'none';
    }

    // ── Inline edit — save ────────────────────────────────────────
    async function saveRow(id) {
        const desc   = $('desc-input-' + id).value.trim();
        const abbrev = $('abbrev-input-' + id).value.trim();
        const calc   = $('calc-input-' + id).value.trim() || '0';
        const ooc    = $('edit-ooc-' + id).checked;
        const sd     = $('edit-sd-' + id).checked;
        const opp    = $('edit-opp-' + id).checked;
        const active = $('edit-active-' + id).checked;
        const btn    = $('save-btn-' + id);

        if (Number(calc) < 0 || Number(calc) >= 10000) {
            showToast('Calculation must be between 0 and 9999.9999.', 'warning');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        try {
            const res = await fetch('@Url.Action("Update", "Paycode")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    Code: id,
                    Description: desc,
                    Abbrev: abbrev,
                    Calculation: calc,
                    OutOfClass: ooc,
                    ShiftDiff: sd,
                    OPP: opp,
                    Active: active,
                    __RequestVerificationToken: token
                })
            });

            const ct = res.headers.get('content-type') || '';
            if (!ct.includes('application/json'))
                throw new Error('Unexpected server response.');

            const data = await res.json();

            if (data.success) {
                const row = $('row-' + id);

                $('desc-display-' + id).textContent = desc;
                $('abbrev-display-' + id).textContent = abbrev;
                $('calc-display-' + id).textContent = Number(calc).toString();

                row.dataset.ooc = ooc.toString();
                row.dataset.sd = sd.toString();
                row.dataset.opp = opp.toString();
                row.dataset.active = active.toString();

                ['desc', 'abbrev', 'calc'].forEach(k => {
                    $(`${k}-display-${id}`).classList.remove('d-none');
                    $(`${k}-input-${id}`).classList.add('d-none');
                });

                $('ooc-cell-' + id).innerHTML    = yesNoBadge(ooc);
                $('sd-cell-' + id).innerHTML     = yesNoBadge(sd);
                $('opp-cell-' + id).innerHTML    = yesNoBadge(opp);
                $('active-cell-' + id).innerHTML = yesNoBadge(active);

                row.classList.replace('table-warning', 'table-success');
                setTimeout(() => row.classList.remove('table-success'), 1500);

                $('actions-view-' + id).style.display = 'block';
                $('actions-edit-' + id).style.display = 'none';
                showToast('Paycode updated.', 'success');
            } else {
                showToast(data.message || 'Save failed.', 'danger');
            }
        } catch (err) {
            showToast(err.message || 'Network error.', 'danger');
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-lg"></i> Save';
    }

    // ── Search debounce ───────────────────────────────────────────
    let searchTimer;
    $('searchInput').addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => $('filterForm').submit(), 500);
    });

    // ── Rows per page ─────────────────────────────────────────────
    $('pageSizeSelect').addEventListener('change', function () {
        $('pageSizeInput').value = this.value;
        $('filterForm').submit();   // currentPage isn't in the form, so it resets to 1
    });
    // ── Export PDF (uses whatever is currently in the filter form) ──
    document.getElementById('exportPaycodesPdf').addEventListener('click', function () {
        const params = new URLSearchParams(new FormData(document.getElementById('filterForm')));
        params.delete('pageSize');   // the export is never paged
        window.location.href = '@Url.Action("ExportPdf", "Paycode")?' + params.toString();
    });
</script>
}
