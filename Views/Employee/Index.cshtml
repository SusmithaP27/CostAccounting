@model CostAccounting.Models.EmployeeIndexVM
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Employees</h3>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
        <i class="bi bi-plus-lg"></i> Add Employee
    </button>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-5">
                <label class="form-label">Search</label>
                <div class="position-relative">
                    <input type="text" id="searchTerm" class="form-control" placeholder="Name or code..." value="@Model.SearchTerm" />
                    <button type="button" id="clearSearch" class="btn-close position-absolute top-50 end-0 translate-middle-y me-2 d-none" aria-label="Clear"></button>
                </div>
            </div>
            <div class="col-12 col-lg-3">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="showInactive" @(Model.ShowInactive ? "checked" : "") />
                    <label class="form-check-label" for="showInactive">Show Inactive</label>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="employeeTableContainer">
    <partial name="_EmployeeTable" model="Model" />
</div>

<!-- Add Employee Modal: minimal fields only — Code is auto-generated from Munis Code -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addEmployeeForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Employee</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">First Name</label>
                            <input type="text" name="FirstName" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">MI</label>
                            <input type="text" name="MI" class="form-control" maxlength="1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Last Name</label>
                            <input type="text" name="LastName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Munis Code</label>
                            <input type="number" name="MunisCode" id="addMunisCode" class="form-control" required />
                            <div class="form-text">Employee Code will be auto-generated: <strong id="addCodePreview">—</strong></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Hire Date</label>
                            <input type="date" name="HireDate" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Employee Modal: every field except rate data (rates are managed on the Employee Rates tab) -->
<div class="modal fade" id="editEmployeeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editEmployeeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ObjectID" id="editObjectID" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Employee</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Code (auto)</label>
                            <input type="text" id="editCodePreview" class="form-control" disabled />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Munis Code</label>
                            <input type="number" name="MunisCode" id="editMunisCode" class="form-control" required />
                        </div>
                        @* <div class="col-md-4">
                            <label class="form-label">SSN</label>
                            <input type="number" name="SSN" id="editSSN" class="form-control" />
                        </div> *@
                        <div class="col-md-5">
                            <label class="form-label">First Name</label>
                            <input type="text" name="FirstName" id="editFirstName" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">MI</label>
                            <input type="text" name="MI" id="editMI" class="form-control" maxlength="1" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Last Name</label>
                            <input type="text" name="LastName" id="editLastName" class="form-control" required />
                        </div>
                        @* <div class="col-md-3">
                            <label class="form-label">Shift</label>
                            <input type="text" name="Shift" id="editShift" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Title Code</label>
                            <input type="text" name="TitleCode" id="editTitleCode" class="form-control" />
                        </div> *@
                        <div class="col-md-3">
                            <label class="form-label">Hire Date</label>
                            <input type="date" name="HireDate" id="editHireDate" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Termination Date</label>
                            <input type="date" name="TerminationDate" id="editTerminationDate" class="form-control" />
                        </div>
                        @* <div class="col-md-3">
                            <label class="form-label">Longevity Rate</label>
                            <input type="number" step="0.01" name="LongevityRate" id="editLongevityRate" class="form-control" />
                        </div> *@
                        <div class="col-md-3">
                            <label class="form-label">Longevity Date</label>
                            <input type="date" name="LongevityDate" id="editLongevityDate" class="form-control" />
                        </div>
                        @* <div class="col-md-3">
                            <label class="form-label">Employee Type ID</label>
                            <input type="number" name="EmployeeTypeObjectID" id="editEmployeeTypeObjectID" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Account ID</label>
                            <input type="number" name="AccountObjectId" id="editAccountObjectId" class="form-control" />
                        </div> *@
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Active" id="editActive" value="true" />
                                <label class="form-check-label" for="editActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteEmployeeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Delete employee <strong id="deleteEmployeeName"></strong>? This sets the record as deleted; it is not physically removed.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmDeleteEmployeeBtn" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="employeeToast" class="toast align-items-center text-white border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="employeeToastBody"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    let deleteTargetId = null;

    function showToast(message, isSuccess) {
        const toastEl = document.getElementById('employeeToast');
        const bodyEl = document.getElementById('employeeToastBody');
        toastEl.classList.remove('bg-success', 'bg-danger');
        toastEl.classList.add(isSuccess ? 'bg-success' : 'bg-danger');
        bodyEl.textContent = message;
        new bootstrap.Toast(toastEl).show();
    }
    window.showEmployeeToast = showToast;

    window.getEmployeeAntiForgeryToken = function () {
        const tokenInput = document.querySelector('#addEmployeeForm input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    };

    // Preview of the auto-generated Code, mirroring EmployeeService.GenerateCodeFromMunisCode
    // (MunisCode padded to a minimum of 4 digits). Server still computes the authoritative value.
    function previewCode(munisCodeValue) {
        if (!munisCodeValue) return '—';
        return munisCodeValue.toString().padStart(4, '0');
    }

    document.getElementById('addMunisCode').addEventListener('input', function () {
        document.getElementById('addCodePreview').textContent = previewCode(this.value);
    });
    document.getElementById('editMunisCode').addEventListener('input', function () {
        document.getElementById('editCodePreview').value = previewCode(this.value);
    });

    function buildParams(page) {
        const params = new URLSearchParams();
        params.set('SearchTerm', document.getElementById('searchTerm').value || '');
        params.set('ShowInactive', document.getElementById('showInactive').checked);
        params.set('SortField', window.employeeSortField || 'LastName');
        params.set('SortDirection', window.employeeSortDir || 'asc');
        params.set('Page', page || 1);
        return params;
    }

    window.refreshEmployeeTable = function (page) {
        const params = buildParams(page);
        fetch('/Employee/GetTable?' + params.toString())
            .then(r => r.text())
            .then(html => {
                document.getElementById('employeeTableContainer').innerHTML = html;
            });
    };

    document.getElementById('searchTerm').addEventListener('input', function () {
        document.getElementById('clearSearch').classList.toggle('d-none', this.value.length === 0);
        refreshEmployeeTable(1);
    });
    document.getElementById('clearSearch').addEventListener('click', function () {
        document.getElementById('searchTerm').value = '';
        this.classList.add('d-none');
        refreshEmployeeTable(1);
    });
    document.getElementById('showInactive').addEventListener('change', () => refreshEmployeeTable(1));

    document.getElementById('addEmployeeForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const formData = new FormData(this);
        const params = new URLSearchParams();
        for (const [key, value] of formData.entries()) params.append(key, value);

        fetch('/Employee/Create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString()
        })
        .then(r => r.json())
        .then(res => {
            showToast(res.message, res.success);
            if (res.success) {
                bootstrap.Modal.getInstance(document.getElementById('addEmployeeModal')).hide();
                this.reset();
                document.getElementById('addCodePreview').textContent = '—';
                refreshEmployeeTable(1);
            }
        });
    });

    // Edit: fetch the full record, populate the Edit modal, show it.
    document.getElementById('employeeTableContainer').addEventListener('click', function (e) {
        const delBtn = e.target.closest('.btn-delete-employee');
        if (delBtn) {
            deleteTargetId = delBtn.dataset.id;
            document.getElementById('deleteEmployeeName').textContent = delBtn.dataset.name;
            new bootstrap.Modal(document.getElementById('deleteEmployeeModal')).show();
            return;
        }

        const editBtn = e.target.closest('.btn-edit-employee');
        if (editBtn) {
            fetch('/Employee/GetById?id=' + editBtn.dataset.id)
                .then(r => r.json())
                .then(emp => {
                    document.getElementById('editObjectID').value = emp.objectID;
                    document.getElementById('editCodePreview').value = emp.code || '';
                    document.getElementById('editMunisCode').value = emp.munisCode || '';
                    @* document.getElementById('editSSN').value = emp.ssn || ''; *@
                    document.getElementById('editFirstName').value = emp.firstName || '';
                    document.getElementById('editMI').value = emp.mi || '';
                    document.getElementById('editLastName').value = emp.lastName || '';
                    @* document.getElementById('editShift').value = emp.shift || '';
                    document.getElementById('editTitleCode').value = emp.titleCode || ''; *@
                    document.getElementById('editHireDate').value = emp.hireDate ? emp.hireDate.substring(0, 10) : '';
                    document.getElementById('editTerminationDate').value = emp.terminationDate ? emp.terminationDate.substring(0, 10) : '';
                    @* document.getElementById('editLongevityRate').value = emp.longevityRate || ''; *@
                    document.getElementById('editLongevityDate').value = emp.longevityDate ? emp.longevityDate.substring(0, 10) : '';
                    @* document.getElementById('editEmployeeTypeObjectID').value = emp.employeeTypeObjectID || '';
                    document.getElementById('editAccountObjectId').value = emp.accountObjectId || ''; *@
                    document.getElementById('editActive').checked = !!emp.active;
                    new bootstrap.Modal(document.getElementById('editEmployeeModal')).show();
                });
        }
    });

    document.getElementById('editEmployeeForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const formData = new FormData(this);
        const params = new URLSearchParams();
        for (const [key, value] of formData.entries()) params.append(key, value);
        if (!document.getElementById('editActive').checked) params.set('Active', 'false');
        params.set('__RequestVerificationToken', window.getEmployeeAntiForgeryToken());

        fetch('/Employee/Update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString()
        })
        .then(r => r.json())
        .then(res => {
            showToast(res.message, res.success);
            if (res.success) {
                bootstrap.Modal.getInstance(document.getElementById('editEmployeeModal')).hide();
                refreshEmployeeTable(document.querySelector('.page-item.active .page-link-nav')?.dataset.page || 1);
            }
        });
    });

    document.getElementById('confirmDeleteEmployeeBtn').addEventListener('click', function () {
        const params = new URLSearchParams();
        params.set('id', deleteTargetId);
        params.set('__RequestVerificationToken', window.getEmployeeAntiForgeryToken());
        fetch('/Employee/Delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString()
        })
        .then(r => r.json())
        .then(res => {
            showToast(res.message, res.success);
            bootstrap.Modal.getInstance(document.getElementById('deleteEmployeeModal')).hide();
            if (res.success) refreshEmployeeTable(1);
        });
    });
})();
</script>
}
