@model CostAccounting.Models.EmployeeIndexVM

@functions {
    string SortIcon(string field, string currentField, string dir)
        => field == currentField ? (dir == "asc" ? "bi-caret-up-fill" : "bi-caret-down-fill") : "bi-caret-down";
    string NextDir(string field, string currentField, string dir)
        => field == currentField && dir == "asc" ? "desc" : "asc";

    // Same truncated pagination window used on the Employee Rate grid.
    List<int?> BuildPageWindow(int current, int total, int window = 1)
    {
        var pages = new List<int?>();
        if (total <= 0) return pages;

        pages.Add(1);
        if (current - window > 2) pages.Add(null);

        for (int p = Math.Max(2, current - window); p <= Math.Min(total - 1, current + window); p++)
            pages.Add(p);

        if (current + window < total - 1) pages.Add(null);
        if (total > 1) pages.Add(total);

        return pages;
    }
}

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th class="sortable" data-field="Code" data-dir="@NextDir("Code", Model.SortField, Model.SortDirection)">
                    Code <i class="bi @SortIcon("Code", Model.SortField, Model.SortDirection)"></i>
                </th>
                <th class="sortable" data-field="LastName" data-dir="@NextDir("LastName", Model.SortField, Model.SortDirection)">
                    Full Name <i class="bi @SortIcon("LastName", Model.SortField, Model.SortDirection)"></i>
                </th>
                <th class="sortable" data-field="HireDate" data-dir="@NextDir("HireDate", Model.SortField, Model.SortDirection)">
                    Hire Date <i class="bi @SortIcon("HireDate", Model.SortField, Model.SortDirection)"></i>
                </th>
                <th class="sortable" data-field="LongevityDate" data-dir="@NextDir("LongevityDate", Model.SortField, Model.SortDirection)">
                    Longevity Date <i class="bi @SortIcon("LongevityDate", Model.SortField, Model.SortDirection)"></i>
                </th>
                <th>Base Rate</th>
                <th>Current Rate</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Employees.Any())
        {
            <tr><td colspan="8" class="text-center text-muted py-4">No employees found.</td></tr>
        }
        @foreach (var e in Model.Employees)
        {
            <tr data-id="@e.ObjectID">
                <td>@e.Code</td>
                <td>@e.FullName</td>
                <td>@(e.HireDate?.ToString("MM/dd/yyyy") ?? "—")</td>
                <td>@(e.LongevityDate?.ToString("MM/dd/yyyy") ?? "—")</td>
                <td>@(e.BaseRate?.ToString("C") ?? "—")</td>
                <td>@(e.CurrentRate?.ToString("C") ?? "—")</td>
                <td>
                    @if (e.Active)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-edit-employee" data-id="@e.ObjectID" title="Edit">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <a href="/EmployeeRate?employeeObjectId=@e.ObjectID" class="btn btn-sm btn-outline-primary" title="Rate History">
                        <i class="bi bi-clock-history"></i>
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete-employee"
                            data-id="@e.ObjectID" data-name="@e.FullName" title="Delete">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="text-muted">
        @if (Model.TotalCount > 0)
        {
            @($"Showing {((Model.Page - 1) * Model.PageSize) + 1}-{Math.Min(Model.Page * Model.PageSize, Model.TotalCount)} of {Model.TotalCount}")
        }
        else
        {
            @("Showing 0 of 0")
        }
    </span>
    <nav>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link page-link-nav" href="#" data-page="@(Model.Page - 1)">Previous</a>
            </li>
            @foreach (var p in BuildPageWindow(Model.Page, Model.TotalPages))
            {
                if (p == null)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                else
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link page-link-nav" href="#" data-page="@p">@p</a>
                    </li>
                }
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link page-link-nav" href="#" data-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>

<script>
(function () {
    const container = document.getElementById('employeeTableContainer');
    if (!container || container.dataset.wired) return;
    container.dataset.wired = 'true';

    container.addEventListener('click', function (e) {
        const sortHeader = e.target.closest('.sortable');
        if (sortHeader) {
            window.employeeSortField = sortHeader.dataset.field;
            window.employeeSortDir = sortHeader.dataset.dir;
            refreshEmployeeTable(1);
            return;
        }

        const pageLink = e.target.closest('.page-link-nav');
        if (pageLink) {
            e.preventDefault();
            refreshEmployeeTable(pageLink.dataset.page);
        }
        // Edit/Delete clicks are handled by the listener in Index.cshtml, which is attached
        // to this same persistent container element.
    });
})();
</script>
