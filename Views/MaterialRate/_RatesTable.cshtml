@model CostAccounting.Models.MaterialRateIndexVM
@{
    string sc = Model.SortColumn ?? "MaterialCode";
    string sd = Model.SortDir ?? "asc";

    string Icon(string col)
    {
        if (!string.Equals(sc, col, StringComparison.OrdinalIgnoreCase))
            return "<i class='bi bi-arrow-down-up text-muted opacity-50 ms-1' style='font-size:.7rem'></i>";
        return sd == "asc"
            ? "<i class='bi bi-sort-up-alt text-primary ms-1' style='font-size:.7rem'></i>"
            : "<i class='bi bi-sort-down-alt text-primary ms-1' style='font-size:.7rem'></i>";
    }
}

<div class="card border-0 shadow-sm"
     data-total-count="@Model.TotalCount"
     data-current-page="@Model.CurrentPage">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0 small" id="ratesTable">
            <thead class="table-light border-bottom">
                <tr>
                    <th class="ps-3 text-center" style="width:50px;">
                        <input type="checkbox" id="chkAll" class="form-check-input" title="Select all" />
                    </th>
                    @* <th class="sortable" data-sort="MaterialCode">Material @Html.Raw(Icon("MaterialCode"))</th> *@
                    <th class="sortable pe-4" data-sort="MaterialCode" style="min-width:280px;">
                        Material @Html.Raw(Icon("MaterialCode"))
                    </th>
                    <th class="sortable" data-sort="StartDate" style="width:140px; min-width:140px;">Start Date @Html.Raw(Icon("StartDate"))</th>
                    <th class="sortable" data-sort="EndDate" style="width:140px; min-width:140px;">End Date @Html.Raw(Icon("EndDate"))</th>
                    <th class="sortable text-end" data-sort="Rate" style="width:110px;">Rate @Html.Raw(Icon("Rate"))</th>
                    <th class="text-end pe-3" style="width:95px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Rates.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-4 d-block mb-1"></i>
                            No rates found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var r in Model.Rates)
                    {
                        <tr id="row-@r.ObjectID">
                            <td class="ps-3 text-center">
                                <input type="checkbox" class="form-check-input row-select" data-id="@r.ObjectID" />
                            </td>

                            @* <td>
                                <span class="badge bg-light text-dark border fw-normal font-monospace me-1">@r.MaterialCode</span>
                                <span class="text-muted">@r.MaterialDescription</span>
                            </td> *@
                            <td class="pe-4">
                                <span class="badge bg-light text-dark border fw-normal font-monospace me-2">@r.MaterialCode</span>
                                <span class="text-muted">@r.MaterialDescription</span>
                            </td>

                            <td>
                                <span class="cell-view">@(r.StartDate.HasValue ? r.StartDate.Value.ToString("M/d/yyyy") : "—")</span>
                                <input type="date" class="cell-input form-control form-control-sm d-none"
                                       data-field="startDate"
                                       value="@(r.StartDate.HasValue ? r.StartDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </td>

                            <td>
                                <span class="cell-view">@(r.EndDate.HasValue ? r.EndDate.Value.ToString("M/d/yyyy") : "—")</span>
                                <input type="date" class="cell-input form-control form-control-sm d-none"
                                       data-field="endDate"
                                       value="@(r.EndDate.HasValue ? r.EndDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </td>

                            <td class="text-end">
                                <span class="cell-view font-monospace">@r.Rate.ToString("N4")</span>
                                <input type="number" step="0.0001" min="0"
                                       class="cell-input form-control form-control-sm d-none text-end"
                                       data-field="rate" value="@r.Rate" />
                            </td>

                            <td class="text-end pe-3 text-nowrap">
                                <button class="btn btn-sm btn-outline-primary py-0 px-2 btn-edit" data-id="@r.ObjectID" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-success py-0 px-2 btn-save d-none" data-id="@r.ObjectID" title="Save">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2 btn-cancel d-none" data-id="@r.ObjectID" title="Cancel">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>