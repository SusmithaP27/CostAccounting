@model CostAccounting.Models.MaterialRateIndexVM
@{
    ViewData["Title"] = "Material Rates";
}

@Html.AntiForgeryToken()

<h4 class="mb-3 fw-semibold">Material Rates</h4>

@* ── FILTER BAR ───────────────────────────────────────────────────────── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3 px-3">
        <form id="filterForm">

            @* Row 1: Material selector *@
            <div class="row g-2 align-items-center mb-2">
                <div class="col-auto">
                    <label class="form-label form-label-sm mb-0">Show rates for this material:</label>
                </div>
                <div class="col-3">
                    <select id="filterMaterialId" class="form-select form-select-sm"
                        @(Model.ShowAllMaterials ? "disabled" : "")>
                        <option value="">— Select a Material —</option>
                        @foreach (var m in Model.Materials)
                        {
                            <option value="@m.ObjectID" selected="@(Model.FilterMaterialId == m.ObjectID)">
                                @m.Code — @m.Description
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="showAllMaterials"
                        @(Model.ShowAllMaterials ? "checked" : "") />
                        <label class="form-check-label form-label-sm" for="showAllMaterials">
                            Show rates for all Materials
                        </label>
                    </div>
                </div>
            </div>

            @* Row 2: Date filters *@
            <div class="row g-2 align-items-center mb-2">
                <div class="col-auto">
                    <label class="form-label form-label-sm mb-0">Show rates where the start date is:</label>
                </div>
                <div class="col-auto">
                    <select id="startDateOperator" class="form-select form-select-sm"
                        @(Model.ShowAllDates ? "disabled" : "")>
                        <option value="<=" selected="@(Model.StartDateOperator == "<=")">&#60;=</option>
                        <option value="<" selected="@(Model.StartDateOperator == "<")">&#60;</option>
                        <option value=">=" selected="@(Model.StartDateOperator == ">=")">&#62;=</option>
                        <option value=">" selected="@(Model.StartDateOperator == ">")">&#62;</option>
                        <option value="=" selected="@(Model.StartDateOperator == "=")">=</option>
                    </select>
                </div>
                <div class="col-auto">
                    <input id="startDateFilter" type="date" class="form-control form-control-sm"
                           value="@(Model.StartDateFilter?.ToString("yyyy-MM-dd"))"
                    @(Model.ShowAllDates ? "disabled" : "") />
                </div>

                <div class="col-auto ms-2">
                    <label class="form-label form-label-sm mb-0">and the end date is:</label>
                </div>
                <div class="col-auto">
                    <select id="endDateOperator" class="form-select form-select-sm"
                        @(Model.ShowAllDates ? "disabled" : "")>
                        <option value="<=" selected="@(Model.EndDateOperator == "<=")">&#60;=</option>
                        <option value="<" selected="@(Model.EndDateOperator == "<")">&#60;</option>
                        <option value=">=" selected="@(Model.EndDateOperator == ">=")">&#62;=</option>
                        <option value=">" selected="@(Model.EndDateOperator == ">")">&#62;</option>
                        <option value="=" selected="@(Model.EndDateOperator == "=")">=</option>
                    </select>
                </div>
                <div class="col-auto">
                    <input id="endDateFilter" type="date" class="form-control form-control-sm"
                           value="@(Model.EndDateFilter?.ToString("yyyy-MM-dd"))"
                    @(Model.ShowAllDates ? "disabled" : "") />
                </div>

                <div class="col-auto ms-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="showAllDates"
                        @(Model.ShowAllDates ? "checked" : "") />
                        <label class="form-check-label form-label-sm" for="showAllDates">
                            Show rates for all dates
                        </label>
                    </div>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Refresh</button>
                    <button type="button" class="btn btn-sm btn-link text-muted text-decoration-none" id="btnClear">
                        Clear All
                    </button>
                </div>
            </div>

            @* Row 3: Search + Add Rate *@
            <div class="row g-2 align-items-center justify-content-between">
                <div class="col-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input id="searchTerm" type="text" autocomplete="off"
                               class="form-control border-start-0 ps-0 bg-white"
                               placeholder="Search material code or description…"
                               value="@Model.SearchTerm" />
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm @(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "d-none" : "")"
                                id="btnClearSearch">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary btn-sm" id="btnOpenAdd" type="button">
                        <i class="bi bi-plus-lg me-1"></i>Add Rate
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@* ── BULK ACTION BAR ──────────────────────────────────────────────────── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 px-3">
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-secondary" id="btnCheckAll" type="button">Check All</button>
                <button class="btn btn-sm btn-outline-secondary" id="btnUncheckAll" type="button">Uncheck All</button>
            </div>
            <div class="col-auto ms-3">
                <label class="form-label form-label-sm mb-0">
                    Update rate end dates for selected rows — New rate end date:
                </label>
            </div>
            <div class="col-auto">
                <input id="newEndDate" type="date" class="form-control form-control-sm"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary" id="btnBulkUpdateEndDate" type="button">Update</button>
            </div>
        </div>
    </div>
</div>

@* ── TABLE (AJAX replaces this) ───────────────────────────────────────── *@
<div id="tableSection">
    @await Html.PartialAsync("_RatesTable", Model)
</div>

@* ── FOOTER: DELETE + PAGINATION + COUNT ─────────────────────────────────
   #paginationNav is the ONLY pagination control. renderPagination() rebuilds
   it after every reload. Don't add a pagination footer to _RatesTable. *@
<div class="d-flex justify-content-between align-items-center mt-2">
    <div>
        <button class="btn btn-sm btn-outline-danger" id="btnDeleteChecked" type="button">
            <i class="bi bi-trash me-1"></i>Delete Checked Rows
        </button>
    </div>
    <nav aria-label="Page navigation" id="paginationNav"></nav>
    <small class="text-muted">
        <span id="selectedCount">0</span> selected &nbsp;·&nbsp;
        <span id="resultCountLabel">@Model.TotalCount results returned</span>
    </small>
</div>

@* ── MODAL: ADD RATE ──────────────────────────────────────────────────── *@
<div class="modal fade" id="modalAdd" tabindex="-1" aria-labelledby="modalAddLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0" id="modalAddLabel">
                    <i class="bi bi-plus-circle me-2"></i>Add New Rate
                </h6>
                <button type="button" class="btn-close btn-close-white btn-sm"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pb-2">
                <div id="addAlertArea"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label form-label-sm fw-semibold">
                            Material <span class="text-danger">*</span>
                        </label>
                        <select id="add_MaterialObjectId" class="form-select form-select-sm">
                            <option value="">— Select a Material —</option>
                            @foreach (var m in Model.Materials)
                            {
                                <option value="@m.ObjectID">@m.Code — @m.Description</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label form-label-sm fw-semibold">Start Date</label>
                        <input id="add_StartDate" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label form-label-sm fw-semibold">End Date</label>
                        <input id="add_EndDate" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label form-label-sm fw-semibold">
                            Rate <span class="text-danger">*</span>
                        </label>
                        <input id="add_Rate" type="number" step="0.0001" min="0"
                               class="form-control form-control-sm" />
                    </div>
                </div>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnSaveAdd">
                    <span id="btnSaveAddSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                    <i class="bi bi-floppy me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

@* ── TOAST ────────────────────────────────────────────────────────────── *@
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="appToast" class="toast align-items-center border-0" role="alert" aria-live="assertive">
        <div class="d-flex">
            <div class="toast-body" id="toastMsg"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    const $   = id  => document.getElementById(id);
    const qsa = sel => document.querySelectorAll(sel);

    // ── State ────────────────────────────────────────────────────────────
    let curPage  = @Model.CurrentPage;
    const pageSize = @Model.PageSize;
    let sortCol  = '@Model.SortColumn';
    let sortDir  = '@Model.SortDir';
    let loadCtrl = null;     // cancels stale requests
    let searchTimer = null;  // live-search debounce

    // ── Helpers ──────────────────────────────────────────────────────────
    function toFormData(data) {
        const fd = new FormData();
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) fd.append('__RequestVerificationToken', token.value);
        for (const [k, v] of Object.entries(data))
            if (v !== null && v !== undefined && v !== '') fd.append(k, v);
        return fd;
    }

    async function apiPost(url, data) {
        const res = await fetch(url, { method: 'POST', body: toFormData(data) });
        if (!res.ok) throw new Error((await res.text()) || res.statusText);
        const json = await res.json();
        if (!json.success) throw new Error(json.message ?? 'Request failed.');
        return json;
    }

    function showToast(msg, type = 'success') {
        const t = $('appToast');
        $('toastMsg').textContent = msg;
        t.className = `toast align-items-center border-0 text-bg-${type}`;
        bootstrap.Toast.getOrCreateInstance(t, { delay: 3000 }).show();
    }

    // ── Query string ─────────────────────────────────────────────────────
    function buildQS() {
        const p = new URLSearchParams();

        const allMat = $('showAllMaterials').checked;
        p.set('showAllMaterials', allMat);
        if (!allMat && $('filterMaterialId').value)
            p.set('filterMaterialId', $('filterMaterialId').value);

        const allDates = $('showAllDates').checked;
        p.set('showAllDates', allDates);
        if (!allDates) {
            p.set('startDateOperator', $('startDateOperator').value);
            if ($('startDateFilter').value) p.set('startDateFilter', $('startDateFilter').value);
            p.set('endDateOperator', $('endDateOperator').value);
            if ($('endDateFilter').value) p.set('endDateFilter', $('endDateFilter').value);
        }

        const term = $('searchTerm').value.trim();
        if (term) p.set('searchTerm', term);

        p.set('sortColumn', sortCol);
        p.set('sortDir', sortDir);
        p.set('page', curPage);
        p.set('pageSize', pageSize);
        return p.toString();
    }

    // ── AJAX reload ──────────────────────────────────────────────────────
    async function reloadTable(page) {
        if (page) curPage = page;

        if (loadCtrl) loadCtrl.abort();
        loadCtrl = new AbortController();

        try {
            const res = await fetch(`@Url.Action("Index", "MaterialRate")?${buildQS()}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                cache: 'no-store',
                signal: loadCtrl.signal
            });
            if (!res.ok) throw new Error('Server error ' + res.status);
            $('tableSection').innerHTML = await res.text();
            bindTableEvents();
            renderPagination();
        } catch (e) {
            if (e.name === 'AbortError') return;
            showToast('Failed to load table.', 'danger');
        }
    }

    // ── Pagination ───────────────────────────────────────────────────────
    function renderPagination() {
        const card  = document.querySelector('#tableSection [data-total-count]');
        const total = card ? +card.dataset.totalCount : 0;
        // server may have stepped back a page after deletes
        if (card && card.dataset.currentPage) curPage = +card.dataset.currentPage;

        $('resultCountLabel').textContent = `${total} results returned`;

        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        const nav = $('paginationNav');
        if (totalPages <= 1) { nav.innerHTML = ''; return; }

        const start = Math.max(1, curPage - 2);
        const end   = Math.min(totalPages, start + 4);

        let html = '<ul class="pagination pagination-sm mb-0">';
        html += `<li class="page-item ${curPage <= 1 ? 'disabled' : ''}">
                    <button class="page-link" data-page="${curPage - 1}"><i class="bi bi-chevron-left"></i></button>
                 </li>`;
        for (let p = start; p <= end; p++) {
            html += `<li class="page-item ${p === curPage ? 'active' : ''}">
                        <button class="page-link" data-page="${p}">${p}</button>
                     </li>`;
        }
        html += `<li class="page-item ${curPage >= totalPages ? 'disabled' : ''}">
                    <button class="page-link" data-page="${curPage + 1}"><i class="bi bi-chevron-right"></i></button>
                 </li>`;
        html += '</ul>';

        nav.innerHTML = html;
        nav.querySelectorAll('[data-page]').forEach(btn =>
            btn.addEventListener('click', () => reloadTable(+btn.dataset.page)));
    }

    // ── Filter bar ───────────────────────────────────────────────────────
    $('filterForm').addEventListener('submit', e => { e.preventDefault(); reloadTable(1); });

    $('showAllMaterials').addEventListener('change', () => {
        $('filterMaterialId').disabled = $('showAllMaterials').checked;
        reloadTable(1);
    });
    $('filterMaterialId').addEventListener('change', () => reloadTable(1));

    $('showAllDates').addEventListener('change', () => {
        const off = $('showAllDates').checked;
        ['startDateOperator', 'startDateFilter', 'endDateOperator', 'endDateFilter']
            .forEach(id => $(id).disabled = off);
        reloadTable(1);
    });
    ['startDateOperator', 'startDateFilter', 'endDateOperator', 'endDateFilter'].forEach(id =>
        $(id).addEventListener('change', () => reloadTable(1)));

    // Live search
    const searchEl = $('searchTerm');
    function syncSearchClear() {
        $('btnClearSearch').classList.toggle('d-none', !searchEl.value);
    }
    function clearSearch() {
        clearTimeout(searchTimer);
        searchEl.value = '';
        syncSearchClear();
        reloadTable(1);
    }
    searchEl.addEventListener('input', () => {
        syncSearchClear();
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => reloadTable(1), 300);
    });
    searchEl.addEventListener('keydown', e => {
        if (e.key === 'Enter')  { e.preventDefault(); clearTimeout(searchTimer); reloadTable(1); }
        if (e.key === 'Escape') { clearSearch(); }
    });
    $('btnClearSearch').addEventListener('click', () => { clearSearch(); searchEl.focus(); });

    // Clear All
    $('btnClear').addEventListener('click', () => {
        $('showAllMaterials').checked = true;
        $('filterMaterialId').value = '';
        $('filterMaterialId').disabled = true;

        $('showAllDates').checked = true;
        $('startDateOperator').value = '<=';
        $('endDateOperator').value = '>=';
        $('startDateFilter').value = '';
        $('endDateFilter').value = '';
        ['startDateOperator', 'startDateFilter', 'endDateOperator', 'endDateFilter']
            .forEach(id => $(id).disabled = true);

        clearTimeout(searchTimer);
        searchEl.value = '';
        syncSearchClear();
        sortCol = 'MaterialCode';
        sortDir = 'asc';
        reloadTable(1);
    });

    // ── Selection ────────────────────────────────────────────────────────
    function updateCount() {
        $('selectedCount').textContent = qsa('.row-select:checked').length;
    }
    function getSelectedIds() {
        return [...qsa('.row-select:checked')].map(cb => cb.dataset.id);
    }
    $('btnCheckAll').addEventListener('click', () => {
        qsa('.row-select').forEach(cb => cb.checked = true);
        updateCount();
    });
    $('btnUncheckAll').addEventListener('click', () => {
        qsa('.row-select').forEach(cb => cb.checked = false);
        updateCount();
    });

    // ── Bulk update end date ─────────────────────────────────────────────
    $('btnBulkUpdateEndDate').addEventListener('click', async () => {
        const ids = getSelectedIds();
        if (!ids.length) { showToast('Select at least one row.', 'danger'); return; }
        if (!$('newEndDate').value) { showToast('Pick a new end date.', 'danger'); return; }

        try {
            const r = await apiPost('@Url.Action("BulkUpdateEndDate", "MaterialRate")', {
                selectedIds: ids.join(','),
                newEndDate : $('newEndDate').value
            });
            showToast(r.message ?? `${ids.length} row(s) updated.`);
            reloadTable(curPage);
        } catch (err) {
            showToast('Update failed: ' + err.message, 'danger');
        }
    });

    // ── Bulk delete ──────────────────────────────────────────────────────
    $('btnDeleteChecked').addEventListener('click', async () => {
        const ids = getSelectedIds();
        if (!ids.length) { showToast('Select at least one row.', 'danger'); return; }
        if (!confirm(`Delete ${ids.length} selected rate(s)? This cannot be undone.`)) return;

        try {
            const r = await apiPost('@Url.Action("BulkDelete", "MaterialRate")', {
                selectedIds: ids.join(',')
            });
            showToast(r.message ?? `${ids.length} row(s) deleted.`);
            reloadTable(curPage);   // server steps back if the page is now empty
        } catch (err) {
            showToast('Delete failed: ' + err.message, 'danger');
        }
    });

    // ── Table events (re-bound after every reload) ───────────────────────
    function bindTableEvents() {
        qsa('.sortable[data-sort]').forEach(th => {
            th.style.cursor = 'pointer';
            th.style.userSelect = 'none';
            th.addEventListener('click', () => {
                const col = th.dataset.sort;
                sortDir = (sortCol.toLowerCase() === col.toLowerCase() && sortDir === 'asc') ? 'desc' : 'asc';
                sortCol = col;
                reloadTable(1);
            });
        });

        const chkAll = $('chkAll');
        if (chkAll) chkAll.addEventListener('change', function () {
            qsa('.row-select').forEach(c => c.checked = this.checked);
            updateCount();
        });
        qsa('.row-select').forEach(c => c.addEventListener('change', updateCount));

        qsa('.btn-edit').forEach(b => b.addEventListener('click', () => enterEdit(b.dataset.id)));
        qsa('.btn-save').forEach(b => b.addEventListener('click', () => saveInline(b.dataset.id)));
        qsa('.btn-cancel').forEach(b => b.addEventListener('click', () => reloadTable(curPage)));

        updateCount();
    }

    function enterEdit(id) {
        const row = $('row-' + id);
        row.querySelectorAll('.cell-view').forEach(el => el.classList.add('d-none'));
        row.querySelectorAll('.cell-input').forEach(el => el.classList.remove('d-none'));
        row.querySelector('.btn-edit').classList.add('d-none');
        row.querySelector('.btn-save').classList.remove('d-none');
        row.querySelector('.btn-cancel').classList.remove('d-none');
        row.querySelector('.cell-input')?.focus();
    }

    async function saveInline(id) {
        const row = $('row-' + id);
        const get = f => row.querySelector(`[data-field="${f}"]`)?.value ?? '';
        const btn = row.querySelector('.btn-save');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        try {
            await apiPost('@Url.Action("UpdateRate", "MaterialRate")', {
                objectId : id,
                rate     : get('rate') || 0,
                startDate: get('startDate'),
                endDate  : get('endDate')
            });
            showToast('Rate updated.');
            reloadTable(curPage);
        } catch (err) {
            showToast('Save failed: ' + err.message, 'danger');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-lg"></i>';
        }
    }

    // ── Add modal ────────────────────────────────────────────────────────
    $('btnOpenAdd').addEventListener('click', () => {
        ['add_MaterialObjectId', 'add_StartDate', 'add_EndDate', 'add_Rate'].forEach(id => {
            $(id).value = '';
            $(id).classList.remove('is-invalid');
        });
        $('addAlertArea').innerHTML = '';
        bootstrap.Modal.getOrCreateInstance($('modalAdd')).show();
    });

    $('btnSaveAdd').addEventListener('click', async () => {
        const matEl  = $('add_MaterialObjectId');
        const rateEl = $('add_Rate');

        const matOk  = !!matEl.value;
        const rateOk = !!rateEl.value && parseFloat(rateEl.value) > 0;
        matEl.classList.toggle('is-invalid', !matOk);
        rateEl.classList.toggle('is-invalid', !rateOk);
        if (!matOk || !rateOk) return;

        const spinner = $('btnSaveAddSpinner');
        spinner.classList.remove('d-none');
        $('btnSaveAdd').disabled = true;

        try {
            await apiPost('@Url.Action("Create", "MaterialRate")', {
                materialObjectId: matEl.value,
                startDate: $('add_StartDate').value,
                endDate  : $('add_EndDate').value,
                rate     : rateEl.value
            });
            bootstrap.Modal.getInstance($('modalAdd')).hide();
            showToast('Rate added successfully.');
            reloadTable(1);
        } catch (err) {
            $('addAlertArea').innerHTML =
                `<div class="alert alert-danger py-1 px-2 small mb-2">
                    <i class="bi bi-exclamation-circle me-1"></i>${err.message}
                 </div>`;
        } finally {
            spinner.classList.add('d-none');
            $('btnSaveAdd').disabled = false;
        }
    });

    $('modalAdd').addEventListener('keydown', e => {
        if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
            e.preventDefault();
            $('btnSaveAdd').click();
        }
    });

    // ── Initial bind ─────────────────────────────────────────────────────
    bindTableEvents();
    renderPagination();
})();
</script>
}