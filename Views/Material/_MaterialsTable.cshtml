@model CostAccounting.Models.MaterialIndexVM
@{
    string sortCol = (ViewBag.SortColumn as string) ?? "Code";
    string sortDir = (ViewBag.SortDir    as string) ?? "asc";

    string SortIcon(string col)
    {
        if (!string.Equals(sortCol, col, StringComparison.OrdinalIgnoreCase))
            return "<i class='bi bi-arrow-down-up text-muted opacity-50 ms-1' style='font-size:.7rem'></i>";
        return sortDir == "asc"
            ? "<i class='bi bi-sort-up-alt text-primary ms-1' style='font-size:.7rem'></i>"
            : "<i class='bi bi-sort-down-alt text-primary ms-1' style='font-size:.7rem'></i>";
    }

    int from  = Model.TotalCount == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int to    = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
    int start = Math.Max(1, Model.CurrentPage - 2);
    int end   = Math.Min(Model.TotalPages, start + 4);
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light border-bottom">
                <tr>
                    <th class="ps-3 sortable" data-sort="Code">
                        Code @Html.Raw(SortIcon("Code"))
                    </th>
                    <th class="sortable" data-sort="Description">
                        Description @Html.Raw(SortIcon("Description"))
                    </th>
                    <th class="sortable" data-sort="EffectiveDate">
                        Eff. Date @Html.Raw(SortIcon("EffectiveDate"))
                    </th>
                    <th class="sortable" data-sort="VendorName">
                        Vendor @Html.Raw(SortIcon("VendorName"))
                    </th>
                    <th class="sortable" data-sort="Contract">
                        Contract @Html.Raw(SortIcon("Contract"))
                    </th>
                    <th class="sortable" data-sort="Unit">
                        Type @Html.Raw(SortIcon("Unit"))
                    </th>
                    <th class="sortable text-end" data-sort="Rate">
                        Rate @Html.Raw(SortIcon("Rate"))
                    </th>
                    <th class="sortable text-center" data-sort="Active">
                        Active @Html.Raw(SortIcon("Active"))
                    </th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Materials.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam fs-3 d-block mb-2 opacity-50"></i>
                            No materials found.
                        </td>
                    </tr>
                }

                @foreach (var m in Model.Materials)
                {
                    <tr id="row-@m.ObjectID"
                        class="@(m.Active != true ? "text-muted" : "")">

                        <td class="ps-3">
                            <span class="badge bg-light text-dark border fw-normal font-monospace">
                                @m.Code
                            </span>
                        </td>

                        <td>
                            <span class="cell-view">@m.Description</span>
                            <input class="cell-input form-control form-control-sm d-none"
                                   data-field="description" value="@m.Description"
                                   style="min-width:160px" />
                        </td>

                        <td>
                            <span class="cell-view">
                                @(m.EffectiveDate?.ToString("MM/dd/yyyy") ?? "—")
                            </span>
                            <input type="date"
                                   class="cell-input form-control form-control-sm d-none"
                                   data-field="effectiveDate"
                                   value="@(m.EffectiveDate?.ToString("yyyy-MM-dd") ?? "")"
                                   style="min-width:130px" />
                        </td>

                        <td>
                            <span class="cell-view">@(m.VendorName ?? "—")</span>
                            <input class="cell-input form-control form-control-sm d-none"
                                   data-field="vendorName" value="@m.VendorName"
                                   style="min-width:140px" />
                        </td>

                        <td>
                            <span class="cell-view">@(m.Contract ?? "—")</span>
                            <input class="cell-input form-control form-control-sm d-none"
                                   data-field="contract" value="@m.Contract"
                                   style="min-width:120px" />
                        </td>

                        <td>
                            <span class="cell-view">@(m.Unit ?? "—")</span>
                            <select class="cell-input form-select form-select-sm d-none"
                                    data-field="unitTypeObjectID"
                                    style="min-width:110px">
                                <option value="">— None —</option>
                                @foreach (var ut in Model.UnitTypes)
                                {
                                    <option value="@ut.ObjectID"
                                            selected="@(m.UnitTypeObjectID == ut.ObjectID ? "selected" : "")">
                                        @ut.Code
                                    </option>
                                }
                            </select>
                        </td>

                        <td class="text-end font-monospace">
                            @m.Rate.ToString("C2")
                        </td>

                        <td class="text-center">
                            <span class="cell-view">
                                @if (m.Active == true)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </span>
                            <div class="cell-input form-check form-switch d-none justify-content-center mb-0">
                                <input class="form-check-input" type="checkbox"
                                       data-field="active"
                                       @(m.Active == true ? "checked" : "") />
                            </div>
                        </td>

                        <td class="text-end pe-3 text-nowrap">
                            <button class="btn btn-sm btn-outline-primary py-0 px-2 btn-edit"
                                    title="Edit" data-id="@m.ObjectID">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-success py-0 px-2 btn-save d-none"
                                    title="Save" data-id="@m.ObjectID">
                                <i class="bi bi-check-lg"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2 btn-cancel d-none"
                                    title="Cancel" data-id="@m.ObjectID">
                                <i class="bi bi-x-lg"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger py-0 px-2 btn-delete"
                                    title="Delete" data-id="@m.ObjectID"
                                    data-code="@m.Code">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex align-items-center justify-content-between py-2 px-3">
            <small class="text-muted">
                Showing @from–@to of @Model.TotalCount
            </small>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" data-page="@(Model.CurrentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>
                    @for (int p = start; p <= end; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <button class="page-link" data-page="@p">@p</button>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <button class="page-link" data-page="@(Model.CurrentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>