@model CostAccounting.Models.EquipmentRateIndexVM

<div class="card border-0 shadow-sm" data-total-count="@Model.TotalCount">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0 small" id="ratesTable">
            <thead class="table-light border-bottom">
                <tr>
                    <th class="ps-3 text-center" style="width:50px;">Select</th>
                    <th>Equipment</th>
                    <th style="width:115px;">Start Date</th>
                    <th style="width:115px;">End Date</th>
                    <th class="text-end" style="width:95px;">Rate</th>
                    <th class="text-end" style="width:95px;">Misc. Rate</th>
                    <th class="text-end pe-3" style="width:95px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Rates.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-4 d-block mb-1"></i>
                            No rates found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var r in Model.Rates)
                    {
                        <tr id="row-@r.ObjectID" data-row="@r.ObjectID">

                            @* Select *@
                            <td class="ps-3 text-center">
                                <input type="checkbox" class="form-check-input row-select"
                                       data-id="@r.ObjectID" />
                            </td>

                            @* Equipment *@
                            <td>
                                <span class="cell-view">@r.EquipmentDisplay</span>
                                <select class="cell-input form-select form-select-sm d-none"
                                        data-field="equipmentObjectId"
                                        style="min-width:220px">
                                    @foreach (var eq in Model.EquipmentList)
                                    {
                                        <option value="@eq.ObjectID"
                                                selected="@(eq.ObjectID == r.EquipmentObjectId)">
                                            @eq.Display
                                        </option>
                                    }
                                </select>
                            </td>

                            @* Start Date *@
                            <td>
                                <span class="cell-view">
                                    @(r.StartDate.HasValue ? r.StartDate.Value.ToString("M/d/yyyy") : "—")
                                </span>
                                <input type="date"
                                       class="cell-input form-control form-control-sm d-none"
                                       data-field="startDate"
                                       value="@(r.StartDate.HasValue ? r.StartDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </td>

                            @* End Date *@
                            <td>
                                <span class="cell-view">
                                    @(r.EndDate.HasValue ? r.EndDate.Value.ToString("M/d/yyyy") : "—")
                                </span>
                                <input type="date"
                                       class="cell-input form-control form-control-sm d-none"
                                       data-field="endDate"
                                       value="@(r.EndDate.HasValue ? r.EndDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </td>

                            @* Rate *@
                            <td class="text-end">
                                <span class="cell-view font-monospace">@r.Rate.ToString("N4")</span>
                                <input type="number" step="0.0001" min="0"
                                       class="cell-input form-control form-control-sm d-none text-end"
                                       data-field="rate"
                                       value="@r.Rate" />
                            </td>

                            @* Misc Rate *@
                            <td class="text-end">
                                <span class="cell-view font-monospace">@r.MiscRate.ToString("N4")</span>
                                <input type="number" step="0.0001" min="0"
                                       class="cell-input form-control form-control-sm d-none text-end"
                                       data-field="miscRate"
                                       value="@r.MiscRate" />
                            </td>

                            @* Actions *@
                            <td class="text-end pe-3 text-nowrap">
                                <button class="btn btn-sm btn-outline-primary py-0 px-2 btn-edit"
                                        data-id="@r.ObjectID" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-success py-0 px-2 btn-save d-none"
                                        data-id="@r.ObjectID" title="Save">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2 btn-cancel d-none"
                                        data-id="@r.ObjectID" title="Cancel">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </td>

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* NOTE: Pagination and the rows-per-page dropdown live in Index.cshtml (outside this partial),
       so AJAX reloads of this table never replace them. Do not add a footer here. *@
</div>
