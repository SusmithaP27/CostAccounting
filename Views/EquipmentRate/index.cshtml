@model CostAccounting.Models.EquipmentRateIndexVM
@{
    ViewData["Title"] = "Equipment Rates";
}

@Html.AntiForgeryToken()

<h4 class="mb-3 fw-semibold">Equipment Rates</h4>

@* ═══════════════════════════════════════════════════════════════════════════
   FILTER BAR
═══════════════════════════════════════════════════════════════════════════ *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3 px-3">
        <form id="filterForm">

            @* Row 1: Equipment selector *@
            <div class="row g-2 align-items-center mb-2">
                <div class="col-auto">
                    <label class="form-label form-label-sm mb-0">Show rates for this item:</label>
                </div>
                <div class="col-3">
                    <select id="filterEquipmentId" class="form-select form-select-sm"
                        @(Model.ShowAllEquipment ? "disabled" : "")>
                        <option value="">— Select Equipment —</option>
                        @foreach (var eq in Model.EquipmentList)
                        {
                            <option value="@eq.ObjectID" selected="@(Model.FilterEquipmentId == eq.ObjectID)">
                                @eq.Display
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="showAllEquipment"
                        @(Model.ShowAllEquipment ? "checked" : "") />
                        <label class="form-check-label form-label-sm" for="showAllEquipment">
                            Show rates for all Equipment
                        </label>
                    </div>
                </div>
            </div>

            @* Row 2: Date range filters *@
            <div class="row g-2 align-items-center mb-2">
                <div class="col-auto">
                    <label class="form-label form-label-sm mb-0">Show rates where the start date is:</label>
                </div>
                <div class="col-auto">
                    <select id="startDateOperator" class="form-select form-select-sm"
                        @(Model.ShowAllDates ? "disabled" : "")>
                        <option value="<=" selected="@(Model.StartDateOperator == "<=")">&#60;=</option>
                        <option value="<" selected="@(Model.StartDateOperator == "<")">&#60;</option>
                        <option value=">=" selected="@(Model.StartDateOperator == ">=")">&#62;=</option>
                        <option value=">" selected="@(Model.StartDateOperator == ">")">&#62;</option>
                        <option value="=" selected="@(Model.StartDateOperator == "=")">=</option>
                    </select>
                </div>
                <div class="col-auto">
                    <input id="startDateFilter" type="date" class="form-control form-control-sm"
                           value="@(Model.StartDateFilter?.ToString("yyyy-MM-dd"))"
                    @(Model.ShowAllDates ? "disabled" : "") />
                </div>

                <div class="col-auto ms-2">
                    <label class="form-label form-label-sm mb-0">and the end date is:</label>
                </div>
                <div class="col-auto">
                    <select id="endDateOperator" class="form-select form-select-sm"
                        @(Model.ShowAllDates ? "disabled" : "")>
                        <option value="<=" selected="@(Model.EndDateOperator == "<=")">&#60;=</option>
                        <option value="<" selected="@(Model.EndDateOperator == "<")">&#60;</option>
                        <option value=">=" selected="@(Model.EndDateOperator == ">=")">&#62;=</option>
                        <option value=">" selected="@(Model.EndDateOperator == ">")">&#62;</option>
                        <option value="=" selected="@(Model.EndDateOperator == "=")">=</option>
                    </select>
                </div>
                <div class="col-auto">
                    <input id="endDateFilter" type="date" class="form-control form-control-sm"
                           value="@(Model.EndDateFilter?.ToString("yyyy-MM-dd"))"
                    @(Model.ShowAllDates ? "disabled" : "") />
                </div>

                <div class="col-auto ms-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="showAllDates"
                        @(Model.ShowAllDates ? "checked" : "") />
                        <label class="form-check-label form-label-sm" for="showAllDates">
                            Show rates for all dates
                        </label>
                    </div>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Refresh</button>
                </div>
            </div>

            @* Row 3: Search + Add Rate *@
            <div class="row g-2 align-items-center justify-content-between">
                <div class="col-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input id="searchTerm" type="text"
                               class="form-control border-start-0 ps-0 bg-white"
                               placeholder="Search equipment code, make, model…"
                               value="@Model.SearchTerm" />
                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearSearch">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary btn-sm" id="btnOpenAdd" type="button">
                        <i class="bi bi-plus-lg me-1"></i>Add Rate
                    </button>
                </div>
            </div>

        </form>

        <hr class="my-3" />

        <p class="small text-muted mb-0">
            <strong>Note about rates:</strong> "Misc Rate" is used on Daily Worksheets and for the Misc. time
            on the Snow &amp; Ice sheets. "Rate" is used for State and County time on the Snow &amp; Ice sheets.
        </p>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════════════
   BULK END-DATE UPDATE BAR
═══════════════════════════════════════════════════════════════════════════ *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 px-3">
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-secondary" id="btnCheckAll" type="button">Check All</button>
                <button class="btn btn-sm btn-outline-secondary" id="btnUncheckAll" type="button">Uncheck All</button>
            </div>
            <div class="col-auto ms-3">
                <label class="form-label form-label-sm mb-0">
                    Update rate end dates for selected rows — New rate end date:
                </label>
            </div>
            <div class="col-auto">
                <input id="newEndDate" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary" id="btnBulkUpdateEndDate" type="button">Update</button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════════════
   TABLE (AJAX replaces this on filter/page)
═══════════════════════════════════════════════════════════════════════════ *@
<div id="tableSection">
    @await Html.PartialAsync("_EquipmentRatesTable", Model)
</div>

@* ═══════════════════════════════════════════════════════════════════════════
   FOOTER: DELETE + PAGINATION + COUNT
   This #paginationNav is the ONLY pagination control for this page — it is
   rebuilt by renderPagination() after every table reload and its buttons are
   bound to reloadTable() right there. Do not add another pagination footer
   inside the _EquipmentRatesTable partial; a previous duplicate there had no
   click handlers wired to it and silently did nothing when clicked.
═══════════════════════════════════════════════════════════════════════════ *@
<div class="d-flex justify-content-between align-items-center mt-2">
    <div>
        <button class="btn btn-sm btn-outline-danger" id="btnDeleteChecked">
            <i class="bi bi-trash me-1"></i>Delete Checked Rows
        </button>
    </div>
    <nav aria-label="Page navigation" id="paginationNav"></nav>
    <small class="text-muted" id="resultCountLabel">@Model.TotalCount results returned</small>
</div>


@* ═══════════════════════════════════════════════════════════════════════════
   MODAL — ADD NEW RATE
═══════════════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalAdd" tabindex="-1" aria-labelledby="modalAddLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">

            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0" id="modalAddLabel">
                    <i class="bi bi-plus-circle me-2"></i>Add New Rate
                </h6>
                <button type="button" class="btn-close btn-close-white btn-sm"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pb-2">
                <div id="addAlertArea"></div>
                <div class="row g-3">

                    <div class="col-12">
                        <label class="form-label form-label-sm fw-semibold">
                            Equipment <span class="text-danger">*</span>
                        </label>
                        <select id="add_EquipmentObjectId" class="form-select form-select-sm">
                            <option value="">— Select Equipment —</option>
                            @foreach (var eq in Model.EquipmentList)
                            {
                                <option value="@eq.ObjectID">@eq.Display</option>
                            }
                        </select>
                        <div class="invalid-feedback">Equipment is required.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label form-label-sm fw-semibold">Start Date</label>
                        <input id="add_StartDate" type="date" class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label form-label-sm fw-semibold">End Date</label>
                        <input id="add_EndDate" type="date" class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label form-label-sm fw-semibold">Rate</label>
                        <input id="add_Rate" type="number" step="0.0001" min="0"
                               class="form-control form-control-sm" value="0" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label form-label-sm fw-semibold">Misc. Rate</label>
                        <input id="add_MiscRate" type="number" step="0.0001" min="0"
                               class="form-control form-control-sm" value="0" />
                    </div>

                </div>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnSaveAdd">
                    <span id="btnSaveAddSpinner"
                          class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                    <i class="bi bi-floppy me-1"></i>Save
                </button>
            </div>

        </div>
    </div>
</div>


@* ═══════════════════════════════════════════════════════════════════════════
   TOAST
═══════════════════════════════════════════════════════════════════════════ *@
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="appToast" class="toast align-items-center border-0" role="alert" aria-live="assertive">
        <div class="d-flex">
            <div class="toast-body" id="toastMsg"></div>
            <button type="button" class="btn-close me-2 m-auto"
                    data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        (function () {
            'use strict';

            const $ = id => document.getElementById(id);

            // ── Pagination state ─────────────────────────────────────────────────
            let curPage  = @Model.CurrentPage;
            const pageSize = @Model.PageSize;

            // ── Helpers ──────────────────────────────────────────────────────────
            function toFormData(data) {
                const fd = new FormData();
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) fd.append('__RequestVerificationToken', token.value);
                for (const [key, val] of Object.entries(data)) {
                    if (Array.isArray(val)) {
                        val.forEach(v => fd.append(key, v));
                    } else if (val !== null && val !== undefined) {
                        fd.append(key, val);
                    }
                }
                return fd;
            }

            async function apiPost(url, data) {
                const res = await fetch(url, { method: 'POST', body: toFormData(data) });
                if (!res.ok) {
                    const txt = await res.text();
                    throw new Error(txt || res.statusText);
                }
                const json = await res.json();
                if (!json.success) throw new Error(json.message ?? 'Request failed.');
                return json;
            }

            function showToast(msg, type = 'success') {
                const toast = $('appToast');
                $('toastMsg').textContent = msg;
                toast.className = `toast align-items-center border-0 text-bg-${type}`;
                bootstrap.Toast.getOrCreateInstance(toast, { delay: 3000 }).show();
            }

            // ── Build query string ────────────────────────────────────────────────
            function buildQS() {
                const p = new URLSearchParams();

                const showAllEquipment = $('showAllEquipment').checked;
                p.set('showAllEquipment', showAllEquipment);
                if (!showAllEquipment && $('filterEquipmentId').value)
                    p.set('filterEquipmentId', $('filterEquipmentId').value);

                const showAllDates = $('showAllDates').checked;
                p.set('showAllDates', showAllDates);
                if (!showAllDates) {
                    p.set('startDateOperator', $('startDateOperator').value);
                    if ($('startDateFilter').value) p.set('startDateFilter', $('startDateFilter').value);
                    p.set('endDateOperator', $('endDateOperator').value);
                    if ($('endDateFilter').value) p.set('endDateFilter', $('endDateFilter').value);
                }

                if ($('searchTerm').value) p.set('searchTerm', $('searchTerm').value);
                p.set('page', curPage);
                p.set('pageSize', pageSize);

                return p.toString();
            }

            // ── AJAX table reload ─────────────────────────────────────────────────
            async function reloadTable(page) {
                if (page) curPage = page;
                try {
                    const res = await fetch(`@Url.Action("Index")?${buildQS()}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    $('tableSection').innerHTML = await res.text();
                    bindTableEvents();
                    renderPagination();
                } catch (e) {
                    showToast('Failed to load table.', 'danger');
                }
            }

            // ── Pagination render ─────────────────────────────────────────────────
            function renderPagination() {
                const totalEl = document.querySelector('#tableSection [data-total-count]');
                const total   = totalEl ? +totalEl.dataset.totalCount : 0;
                $('resultCountLabel').textContent = `${total} results returned`;

                const totalPages = Math.max(1, Math.ceil(total / pageSize));
                const nav = $('paginationNav');

                if (totalPages <= 1) { nav.innerHTML = ''; return; }

                const start = Math.max(1, curPage - 2);
                const end   = Math.min(totalPages, start + 4);

                let html = '<ul class="pagination pagination-sm mb-0">';
                html += `<li class="page-item ${curPage <= 1 ? 'disabled' : ''}">
                            <button class="page-link" data-page="${curPage - 1}">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                         </li>`;
                for (let p = start; p <= end; p++) {
                    html += `<li class="page-item ${p === curPage ? 'active' : ''}">
                                <button class="page-link" data-page="${p}">${p}</button>
                             </li>`;
                }
                html += `<li class="page-item ${curPage >= totalPages ? 'disabled' : ''}">
                            <button class="page-link" data-page="${curPage + 1}">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                         </li>`;
                html += '</ul>';

                nav.innerHTML = html;
                nav.querySelectorAll('[data-page]').forEach(btn => {
                    btn.addEventListener('click', () => reloadTable(+btn.dataset.page));
                });
            }

            // ── Filter bar ────────────────────────────────────────────────────────
            $('filterForm').addEventListener('submit', e => { e.preventDefault(); reloadTable(1); });

            $('showAllEquipment').addEventListener('change', () => {
                $('filterEquipmentId').disabled = $('showAllEquipment').checked;
                reloadTable(1);
            });
            $('filterEquipmentId').addEventListener('change', () => reloadTable(1));

            $('showAllDates').addEventListener('change', () => {
                const off = $('showAllDates').checked;
                ['startDateOperator','startDateFilter','endDateOperator','endDateFilter']
                    .forEach(id => $(id).disabled = off);
                reloadTable(1);
            });
            ['startDateOperator','startDateFilter','endDateOperator','endDateFilter'].forEach(id => {
                $(id).addEventListener('change', () => reloadTable(1));
            });

            $('searchTerm').addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); reloadTable(1); }
            });

            $('btnClearSearch')?.addEventListener('click', () => {
                $('searchTerm').value = '';
                reloadTable(1);
            });

            // ── Check / Uncheck all ───────────────────────────────────────────────
            $('btnCheckAll').addEventListener('click', () => {
                document.querySelectorAll('.row-select').forEach(cb => cb.checked = true);
            });
            $('btnUncheckAll').addEventListener('click', () => {
                document.querySelectorAll('.row-select').forEach(cb => cb.checked = false);
            });

            function getSelectedIds() {
                return [...document.querySelectorAll('.row-select:checked')].map(cb => +cb.dataset.id);
            }

            // ── Bulk update end date ──────────────────────────────────────────────
            $('btnBulkUpdateEndDate').addEventListener('click', async () => {
                const ids = getSelectedIds();
                if (ids.length === 0) { showToast('Select at least one row.', 'danger'); return; }
                if (!$('newEndDate').value) { showToast('Pick a new end date.', 'danger'); return; }

                try {
                    await apiPost('@Url.Action("BulkUpdateEndDate", "EquipmentRate")', {
                        objectIds: ids,
                        newEndDate: $('newEndDate').value
                    });
                    showToast(`${ids.length} row(s) updated.`);
                    reloadTable(curPage);
                } catch (err) {
                    showToast('Update failed: ' + err.message, 'danger');
                }
            });

            // ── Bulk delete ───────────────────────────────────────────────────────
            $('btnDeleteChecked').addEventListener('click', async () => {
                const ids = getSelectedIds();
                if (ids.length === 0) { showToast('Select at least one row.', 'danger'); return; }
                if (!confirm(`Delete ${ids.length} selected rate(s)? This cannot be undone.`)) return;

                try {
                    await apiPost('@Url.Action("BulkDelete", "EquipmentRate")', { objectIds: ids });
                    showToast(`${ids.length} row(s) deleted.`);
                    reloadTable(1);
                } catch (err) {
                    showToast('Delete failed: ' + err.message, 'danger');
                }
            });

            // ── Bind inline-edit events after every table reload ──────────────────
            function bindTableEvents() {
                document.querySelectorAll('.btn-edit').forEach(btn => {
                    btn.addEventListener('click', () => enterEdit(btn.dataset.id));
                });
                document.querySelectorAll('.btn-save').forEach(btn => {
                    btn.addEventListener('click', () => saveInline(btn.dataset.id));
                });
                document.querySelectorAll('.btn-cancel').forEach(btn => {
                    btn.addEventListener('click', () => reloadTable(curPage));
                });
            }

            function enterEdit(id) {
                const row = document.getElementById('row-' + id);
                row.querySelectorAll('.cell-view') .forEach(el => el.classList.add('d-none'));
                row.querySelectorAll('.cell-input').forEach(el => el.classList.remove('d-none'));
                row.querySelector('.btn-edit')  .classList.add('d-none');
                row.querySelector('.btn-save')  .classList.remove('d-none');
                row.querySelector('.btn-cancel').classList.remove('d-none');
                row.querySelector('.cell-input')?.focus();
            }

            async function saveInline(id) {
                const row = document.getElementById('row-' + id);
                const get = field => row.querySelector(`[data-field="${field}"]`)?.value || null;

                const eqSelect = row.querySelector('[data-field="equipmentObjectId"]');
                const payload = {
                    objectID:          +id,
                    equipmentObjectId: +eqSelect.value,
                    startDate:         get('startDate'),
                    endDate:           get('endDate'),
                    rate:              get('rate')     || 0,
                    miscRate:          get('miscRate') || 0
                };

                const saveBtn = row.querySelector('.btn-save');
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                try {
                    await apiPost('@Url.Action("Update", "EquipmentRate")', payload);
                    showToast('Saved successfully.');
                    reloadTable(curPage);
                } catch (err) {
                    showToast('Save failed: ' + err.message, 'danger');
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = '<i class="bi bi-check-lg"></i>';
                }
            }

            // ── Add modal ─────────────────────────────────────────────────────────
            $('btnOpenAdd').addEventListener('click', () => {
                $('add_EquipmentObjectId').value = '';
                $('add_EquipmentObjectId').classList.remove('is-invalid');
                $('add_StartDate').value  = '';
                $('add_EndDate').value    = '';
                $('add_Rate').value       = '0';
                $('add_MiscRate').value   = '0';
                $('addAlertArea').innerHTML = '';
                bootstrap.Modal.getOrCreateInstance($('modalAdd')).show();
            });

            $('btnSaveAdd').addEventListener('click', async () => {
                const eqEl = $('add_EquipmentObjectId');
                if (!eqEl.value) {
                    eqEl.classList.add('is-invalid');
                    eqEl.focus();
                    return;
                }
                eqEl.classList.remove('is-invalid');

                const payload = {
                    equipmentObjectId: +eqEl.value,
                    startDate:         $('add_StartDate').value || null,
                    endDate:           $('add_EndDate').value   || null,
                    rate:              $('add_Rate').value      || 0,
                    miscRate:          $('add_MiscRate').value  || 0
                };

                const spinner = $('btnSaveAddSpinner');
                spinner.classList.remove('d-none');
                $('btnSaveAdd').disabled = true;

                try {
                    await apiPost('@Url.Action("Create", "EquipmentRate")', payload);
                    bootstrap.Modal.getInstance($('modalAdd')).hide();
                    showToast('Rate added successfully.');
                    reloadTable(1);
                } catch (err) {
                    $('addAlertArea').innerHTML =
                        `<div class="alert alert-danger alert-sm py-1 px-2 small mb-2">
                            <i class="bi bi-exclamation-circle me-1"></i>${err.message}
                         </div>`;
                } finally {
                    spinner.classList.add('d-none');
                    $('btnSaveAdd').disabled = false;
                }
            });

            $('modalAdd').addEventListener('keydown', e => {
                if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
                    e.preventDefault();
                    $('btnSaveAdd').click();
                }
            });

            // ── Initial bind ──────────────────────────────────────────────────────
            bindTableEvents();
            renderPagination();

        })();
    </script>
}
